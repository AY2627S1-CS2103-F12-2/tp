@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "TutorLink Storage" #F4F6F6{
Class JsonTutorLinkStorage
Class JsonSerializableTutorLink
Class JsonAdaptedStudent
Class JsonAdaptedInteraction
Class JsonAdaptedFollowUp
}

}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonTutorLinkStorage

JsonTutorLinkStorage ..> JsonSerializableTutorLink
JsonSerializableTutorLink --> "*" JsonAdaptedStudent
JsonAdaptedStudent --> "*" JsonAdaptedInteraction
JsonAdaptedStudent --> "*" JsonAdaptedFollowUp

@enduml
