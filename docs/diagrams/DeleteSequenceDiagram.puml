@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":TutorLinkParser" as TutorLinkParser LOGIC_COLOR
participant ":DeleteInteractionCommandParser" as DeleteInteractionCommandParser LOGIC_COLOR
participant "d:DeleteInteractionCommand" as DeleteInteractionCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("interaction delete n/John Tan i/1")
activate LogicManager

LogicManager -> TutorLinkParser : parseCommand("interaction delete n/John Tan i/1")
activate TutorLinkParser

create DeleteInteractionCommandParser
TutorLinkParser -> DeleteInteractionCommandParser
activate DeleteInteractionCommandParser

DeleteInteractionCommandParser --> TutorLinkParser
deactivate DeleteInteractionCommandParser

TutorLinkParser -> DeleteInteractionCommandParser : parse(" n/John Tan i/1")
activate DeleteInteractionCommandParser

create DeleteInteractionCommand
DeleteInteractionCommandParser -> DeleteInteractionCommand
activate DeleteInteractionCommand

DeleteInteractionCommand --> DeleteInteractionCommandParser
deactivate DeleteInteractionCommand

DeleteInteractionCommandParser --> TutorLinkParser : d
deactivate DeleteInteractionCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteInteractionCommandParser -[hidden]-> TutorLinkParser
destroy DeleteInteractionCommandParser

TutorLinkParser --> LogicManager : d
deactivate TutorLinkParser

LogicManager -> DeleteInteractionCommand : execute(m)
activate DeleteInteractionCommand

DeleteInteractionCommand -> Model : findStudentByName(John Tan)
activate Model

Model --> DeleteInteractionCommand : Optional[John Tan]
deactivate Model

DeleteInteractionCommand -> Model : setStudent(John Tan, updatedStudent)
activate Model

Model --> DeleteInteractionCommand
deactivate Model

create CommandResult
DeleteInteractionCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteInteractionCommand
deactivate CommandResult

DeleteInteractionCommand --> LogicManager : r
deactivate DeleteInteractionCommand

[<--LogicManager
deactivate LogicManager
@enduml
