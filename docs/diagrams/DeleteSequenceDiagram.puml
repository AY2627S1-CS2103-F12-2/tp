@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam dpi 150
skinparam sequenceMessageAlign left
skinparam sequenceMessageFontSize 18
skinparam sequenceParticipantFontSize 18
skinparam NoteFontSize 16

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:DeleteInteractionCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "s:Student" as Student MODEL_COLOR
end box

[-> LogicManager : execute(commandText)
activate LogicManager
LogicManager -> Command : execute(m)
activate Command

Command -> Model : findStudentByName(name)
activate Model
Model --> Command : Optional[s]
deactivate Model

Command -> Student : getInteractionsInChronologicalOrder()
activate Student
Student --> Command : displayedInteractions
deactivate Student

note over Command
    Displayed index 1 is in range.
    Its zero-based position is 0.
end note

Command -> Student : withoutInteractionAtChronologicalIndex(0)
activate Student
Student --> Command : updatedStudent
deactivate Student

Command -> Model : setStudent(s, updatedStudent)
activate Model
Model --> Command
deactivate Model

Command --> LogicManager : result:CommandResult
deactivate Command

note over LogicManager
    Changed data is saved
    before success is returned.
end note

[<-- LogicManager : result
deactivate LogicManager
@enduml
