@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":TutorLinkParser" as TutorLinkParser LOGIC_COLOR
participant ":EditStudentCommandParser" as EditStudentCommandParser LOGIC_COLOR
participant "e:EditStudentCommand" as EditStudentCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("student edit n/john tan new/Jonathan Tan")
activate LogicManager

LogicManager -> TutorLinkParser : parseCommand("student edit n/john tan new/Jonathan Tan")
activate TutorLinkParser

create EditStudentCommandParser
TutorLinkParser -> EditStudentCommandParser
activate EditStudentCommandParser

EditStudentCommandParser --> TutorLinkParser
deactivate EditStudentCommandParser

TutorLinkParser -> EditStudentCommandParser : parse(" n/john tan new/Jonathan Tan")
activate EditStudentCommandParser

create EditStudentCommand
EditStudentCommandParser -> EditStudentCommand
activate EditStudentCommand

EditStudentCommand --> EditStudentCommandParser
deactivate EditStudentCommand

EditStudentCommandParser --> TutorLinkParser : e
deactivate EditStudentCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
EditStudentCommandParser -[hidden]-> TutorLinkParser
destroy EditStudentCommandParser

TutorLinkParser --> LogicManager : e
deactivate TutorLinkParser

LogicManager -> EditStudentCommand : execute(m)
activate EditStudentCommand

EditStudentCommand -> Model : findStudentByName(john tan)
activate Model

Model --> EditStudentCommand : Optional[John Tan]
deactivate Model

EditStudentCommand -> EditStudentCommand : createEditedStudent(John Tan)
activate EditStudentCommand

EditStudentCommand --> EditStudentCommand : Jonathan Tan
deactivate EditStudentCommand

EditStudentCommand -> Model : hasStudent(Jonathan Tan)
activate Model

Model --> EditStudentCommand : false
deactivate Model

EditStudentCommand -> Model : setStudent(John Tan, Jonathan Tan)
activate Model

Model --> EditStudentCommand
deactivate Model

create CommandResult
EditStudentCommand -> CommandResult
activate CommandResult

CommandResult --> EditStudentCommand
deactivate CommandResult

EditStudentCommand --> LogicManager : r
deactivate EditStudentCommand

[<--LogicManager
deactivate LogicManager
@enduml
