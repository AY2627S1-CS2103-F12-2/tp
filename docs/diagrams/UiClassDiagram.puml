@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 45
skinparam dpi 150

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class UiManager
Class MainWindow
together {
Class CommandBox
Class ResultDisplay
Class StatusBarFooter
Class HelpWindow
}
together {
Class StudentListPanel
Class StudentDetailPanel
Class InteractionPanel
Class FollowUpPanel
}
Class StudentCard
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" StudentListPanel
MainWindow *-down-> "1" StudentDetailPanel
MainWindow *-down-> "1" InteractionPanel
MainWindow *-down-> "1" FollowUpPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow -down-> "1" HelpWindow

StudentListPanel -down-> "*" StudentCard

StudentCard .right.> Model
StudentDetailPanel .down.> Model
InteractionPanel .down.> Model
FollowUpPanel .down.> Model
UiManager -right-> Logic
MainWindow -right-> Logic

CommandBox -[hidden]right-> ResultDisplay
ResultDisplay -[hidden]right-> StatusBarFooter
StatusBarFooter -[hidden]right-> HelpWindow
StudentListPanel -[hidden]right-> StudentDetailPanel
StudentDetailPanel -[hidden]right-> InteractionPanel
InteractionPanel -[hidden]right-> FollowUpPanel
CommandBox -[hidden]down-> StudentListPanel

legend bottom
    All shown UI classes except Ui and UiManager extend UiPart.
    Common inheritance arrows are omitted for clarity.
endlegend
@enduml
